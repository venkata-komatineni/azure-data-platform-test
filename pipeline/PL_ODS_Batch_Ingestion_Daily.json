{
  "name": "PL_ODS_Batch_Ingestion_Daily",
  "properties": {
    "description": "Daily batch ingestion pipeline. Reads incremental data from ODS source tables. Lands raw Avro files in ADLS Gen2. Validates load via Databricks validation notebook. Updates watermark on success. Alerts on failure.",
    "activities": [
      {
        "name": "LKP_GetIngestionConfig",
        "description": "Read all active table configs from the central watermark control table.",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 1,
          "retryIntervalInSeconds": 30
        },
        "typeProperties": {
          "source": {
            "type": "AzureSqlSource",
            "sqlReaderQuery": "SELECT source_schema, source_table, watermark_column, watermark_value, target_folder, target_file_prefix, active_flag FROM control.ingestion_watermark WHERE active_flag = 1 ORDER BY source_table",
            "queryTimeout": "00:10:00"
          },
          "dataset": {
            "referenceName": "DS_ControlDB_WatermarkTable",
            "type": "DatasetReference"
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "FE_ProcessAllTables",
        "description": "Iterate over each active source table config and run copy + validate + watermark update.",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "LKP_GetIngestionConfig",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('LKP_GetIngestionConfig').output.value",
            "type": "Expression"
          },
          "isSequential": false,
          "batchCount": 5,
          "activities": [
            {
              "name": "CPY_ODS_To_LandingZone",
              "description": "Incremental copy from SQL Server ODS table to ADLS Gen2 landing zone as Avro.",
              "type": "Copy",
              "dependsOn": [],
              "policy": {
                "timeout": "0.02:00:00",
                "retry": 2,
                "retryIntervalInSeconds": 60
              },
              "typeProperties": {
                "source": {
                  "type": "SqlServerSource",
                  "sqlReaderQuery": {
                    "value": "@concat('SELECT * FROM ', item().source_schema, '.', item().source_table, ' WHERE ', item().watermark_column, ' >= ''', item().watermark_value, '''')",
                    "type": "Expression"
                  },
                  "queryTimeout": "01:00:00"
                },
                "sink": {
                  "type": "AvroSink",
                  "storeSettings": {
                    "type": "AzureBlobFSWriteSettings",
                    "maxConcurrentConnections": 4
                  },
                  "formatSettings": {
                    "type": "AvroWriteSettings",
                    "maxRowsPerFile": 500000,
                    "fileNamePrefix": {
                      "value": "@concat(item().target_file_prefix, '_', formatDateTime(utcNow(), 'yyyyMMdd_HHmmss'))",
                      "type": "Expression"
                    }
                  }
                },
                "enableStaging": false,
                "dataIntegrationUnits": 8,
                "parallelCopies": 4
              },
              "inputs": [
                {
                  "referenceName": "DS_SQLServer_ODS_Source",
                  "type": "DatasetReference",
                  "parameters": {
                    "schemaName": {
                      "value": "@item().source_schema",
                      "type": "Expression"
                    },
                    "tableName": {
                      "value": "@item().source_table",
                      "type": "Expression"
                    }
                  }
                }
              ],
              "outputs": [
                {
                  "referenceName": "DS_ADLS_LandingZone_Avro",
                  "type": "DatasetReference",
                  "parameters": {
                    "targetFolder": {
                      "value": "@concat('landingzone/', item().target_folder)",
                      "type": "Expression"
                    }
                  }
                }
              ]
            },
            {
              "name": "NB_ValidateLoad",
              "description": "Run Databricks validation notebook. Returns PASSED or FAILED.",
              "type": "DatabricksNotebook",
              "dependsOn": [
                {
                  "activity": "CPY_ODS_To_LandingZone",
                  "dependencyConditions": ["Succeeded"]
                }
              ],
              "policy": {
                "timeout": "0.00:30:00",
                "retry": 1,
                "retryIntervalInSeconds": 60
              },
              "typeProperties": {
                "notebookPath": "/Shared/Frameworks/NB_DataValidationFramework",
                "baseParameters": {
                  "source_schema": {
                    "value": "@item().source_schema",
                    "type": "Expression"
                  },
                  "source_table": {
                    "value": "@item().source_table",
                    "type": "Expression"
                  },
                  "watermark_column": {
                    "value": "@item().watermark_column",
                    "type": "Expression"
                  },
                  "watermark_value": {
                    "value": "@item().watermark_value",
                    "type": "Expression"
                  },
                  "batch_id": {
                    "value": "@pipeline().RunId",
                    "type": "Expression"
                  }
                }
              },
              "linkedServiceName": {
                "referenceName": "LS_Databricks_ValidationCluster",
                "type": "LinkedServiceReference"
              }
            },
            {
              "name": "IF_ValidationResult",
              "description": "Branch on PASSED or FAILED validation output.",
              "type": "IfCondition",
              "dependsOn": [
                {
                  "activity": "NB_ValidateLoad",
                  "dependencyConditions": ["Succeeded"]
                }
              ],
              "typeProperties": {
                "expression": {
                  "value": "@equals(activity('NB_ValidateLoad').output.runOutput, 'PASSED')",
                  "type": "Expression"
                },
                "ifTrueActivities": [
                  {
                    "name": "SCR_UpdateWatermark",
                    "description": "Update watermark to current run timestamp on success.",
                    "type": "Script",
                    "dependsOn": [],
                    "typeProperties": {
                      "scripts": [
                        {
                          "type": "Query",
                          "text": {
                            "value": "@concat('UPDATE control.ingestion_watermark SET watermark_value = ''', formatDateTime(utcNow(), 'yyyy-MM-dd HH:mm:ss'), ''', last_successful_run = GETUTCDATE(), last_batch_id = ''', pipeline().RunId, ''' WHERE source_table = ''', item().source_table, '''')",
                            "type": "Expression"
                          }
                        }
                      ]
                    },
                    "linkedServiceName": {
                      "referenceName": "LS_ControlDB",
                      "type": "LinkedServiceReference"
                    }
                  }
                ],
                "ifFalseActivities": [
                  {
                    "name": "WEB_AlertTeams",
                    "description": "Send Teams webhook alert on validation failure.",
                    "type": "WebActivity",
                    "dependsOn": [],
                    "typeProperties": {
                      "url": "https://placeholder.webhook.office.com/webhookb2/TEAMS_WEBHOOK_URL",
                      "method": "POST",
                      "headers": {
                        "Content-Type": "application/json"
                      },
                      "body": {
                        "value": "@concat('{\"title\": \"ADF Ingestion Validation FAILED\", \"text\": \"Pipeline: ', pipeline().Pipeline, ' | Table: ', item().source_table, ' | BatchId: ', pipeline().RunId, '\"}')",
                        "type": "Expression"
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ],
    "annotations": [
      "Batch Ingestion",
      "ODS to Landing Zone",
      "Incremental Watermark"
    ],
    "variables": {
      "pipelineRunId": {
        "type": "String"
      }
    },
    "folder": {
      "name": "01_Ingestion"
    }
  }
}
